<?xml version="1.0" encoding="utf-8"?>
<!-- 追番绑定确认弹窗面板：与搜索弹窗同款深色渐变 + 白色描边，居中弹窗四角全圆 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="315"
        android:centerColor="#D6282955"
        android:endColor="#CC303463"
        android:startColor="#E62F315E" />

    <corners android:radius="22dp" />

    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
</shape>
